#, python-format
msgid "%(link)s is an SMS operator for businesses in Uzbekistan, used by banks, payment systems and online stores to message their customers. Connect a short code you have with Play Mobile to send and receive SMS with your contacts."
msgstr "%(link)s es un operador de SMS para empresas en Uzbekistán, que usan bancos, sistemas de pago y tiendas en línea para enviar mensajes a sus clientes. Conecte un código corto que tenga con Play Mobile para enviar y recibir SMS con sus contactos."

msgid "To finish configuring this channel, you'll need to notify Play Mobile of the following URL."
msgstr "Para terminar de configurar este canal, deberá notificar a Play Mobile la siguiente URL."

msgid "To receive incoming messages, you need to set the receive URL for your Play Mobile account."
msgstr "Para recibir mensajes entrantes, debe configurar la URL de recepción para su cuenta de Play Mobile."

#, python-format
msgid "%(link)s offers phone numbers in many countries for SMS. Connect a number from your Plivo account, or buy a new one, and contacts can text it to start your flows."
msgstr "%(link)s ofrece números de teléfono en muchos países para SMS. Conecte un número de su cuenta de Plivo, o compre uno nuevo, y los contactos podrán enviarle mensajes para iniciar sus flujos."

msgid "Unable to create a Plivo application for that number, please try again."
msgstr "No se pudo crear una aplicación de Plivo para ese número. Vuelve a intentarlo."

msgid "There was a problem updating that number, please try again."
msgstr "Hubo un problema al actualizar ese número. Vuelve a intentarlo."

msgid "That number is not currently supported."
msgstr "Ese número no se admite actualmente."

msgid "There was a problem claiming that number, please check the balance on your account."
msgstr "Hubo un problema al solicitar ese número, por favor, verifique el saldo en su cuenta."

msgid "Auth ID"
msgstr "ID de autenticación"

msgid "Auth Token"
msgstr "Token de autenticación"

msgid "Your Plivo auth ID and auth token seem invalid. Please check them again and retry."
msgstr "Su ID de autenticación de Plivo y su token de autenticación parecen no válidos. Revíselos de nuevo y vuelva a intentarlo."

msgid "Plivo credentials verified. You can now add a Plivo channel."
msgstr "Credenciales de Plivo verificadas. Ahora puede agregar un canal de Plivo."

msgid "Connection to RocketChat is taking too long."
msgstr "La conexión a RocketChat está tardando demasiado."

msgid "Unable to configure. Connection to RocketChat is taking too long."
msgstr "No se puede configurar. La conexión a RocketChat está tardando demasiado."

