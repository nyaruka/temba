#, python-format
msgid "You can connect a <a href=\"https://jiochat.com\">JioChat Channel</a> to your %(name)s workspace to automate sending and receiving JioChat messages."
msgstr "Puede conectar un canal JioChat <a href=\"https://jiochat.com\"> </a> a su workspace %(name)s para automatizar el envío y la recepción de mensajes JioChat."

