#, python-format
msgid "You are about to delete the shortcut <b>%(object)s</b>. There is no way to undo this. Are you sure?"
msgstr "Está a punto de eliminar el atajo <b>%(object)s</b>. No hay forma de deshacer esto. ¿Está seguro?"

msgid "These are canned responses that agents can use to quickly reply to tickets."
msgstr "Estas son respuestas predefinidas que los agentes pueden utilizar para responder rápidamente a los tickets."

#, python-format
msgid "Sorry, the <b>%(object)s</b> team can't be deleted while it still has agents. Move the agents to another team first and then try again."
msgstr "Lo sentimos, el equipo <b>%(object)s</b> no se puede eliminar mientras siga teniendo agentes. Mueva primero los agentes a otro equipo y vuelva a intentarlo."

#, python-format
msgid "Sorry, the <b>%(object)s</b> team can't be deleted while it still has pending invitations. Cancel the invitations and then try again."
msgstr "Lo sentimos, el equipo <b>%(object)s</b> no se puede eliminar mientras siga teniendo invitaciones pendientes. Cancele las invitaciones y vuelva a intentarlo."

#, python-format
msgid "You are about to delete the <b>%(object)s</b> team. There is no way to undo this. Are you sure?"
msgstr "Está a punto de eliminar el equipo <b>%(object)s</b>. No hay forma de deshacer esto. ¿Está seguro?"

msgid "Ticket search is not currently supported for teams that are restricted to specific topics."
msgstr "La búsqueda de tickets no está disponible actualmente para los equipos restringidos a temas específicos."

msgid "Agent users can be organized into teams to restrict which ticket topics they can access."
msgstr "Los usuarios agentes se pueden organizar en equipos para restringir a qué temas de tickets pueden acceder."

msgid "No teams"
msgstr "Sin equipos"

msgid "Tickets Opened"
msgstr "Tickets abiertos"

msgid "Response Count"
msgstr "Número de respuestas"

msgid "Top Responders"
msgstr "Principales respondedores"

msgid "User"
msgstr "Usuario"

msgid "Replies"
msgstr "Respuestas"

msgid "Loading..."
msgstr "Cargando..."

msgid "No replies in this period"
msgstr "No hay respuestas en este período"

msgid "Failed to load"
msgstr "Error al cargar"

msgid "Any tickets opened within the selected date range will be included. You may optionally include additional columns for fields for each contact."
msgstr "Se incluirán todos los tickets abiertos dentro del rango de fechas seleccionado. Opcionalmente puede incluir columnas adicionales para los campos de cada contacto."

msgid "All Agents"
msgstr "Todos los agentes"

msgid "See more tickets"
msgstr "Ver más tickets"

msgid "All done!"
msgstr "¡Todo listo!"

msgid "Nice work, there aren't any more tickets here that need your attention."
msgstr "Buen trabajo, no hay más entradas aquí que requieran su atención."

#, python-format
msgid "%(name)s Tickets makes it easy to chat directly with your contacts."
msgstr "%(name)s Tickets facilita chatear directamente con sus contactos."

msgid "Sometimes an automated chatbot isn't enough. When your contacts need to chat with a real person, you can use the Open Ticket action to open a new ticket."
msgstr "A veces, un chatbot automatizado no es suficiente. Cuando sus contactos necesiten chatear con una persona real, puede utilizar la acción Abrir ticket para abrir un nuevo ticket."

#, python-format
msgid "Sorry, the <b>%(object)s</b> topic can't be deleted while it still has tickets. Move the tickets to another topic first and then try again."
msgstr "Lo sentimos, el tema <b>%(object)s</b> no se puede eliminar mientras siga teniendo tickets. Mueva primero los tickets a otro tema y vuelva a intentarlo."

#, python-format
msgid "You are about to delete the <b>%(object)s</b> topic. There is no way to undo this. Are you sure?"
msgstr "Está a punto de eliminar el tema <b>%(object)s</b>. No hay forma de deshacer esto. ¿Está seguro?"

