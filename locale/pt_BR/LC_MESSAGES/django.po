msgstr "novo campo"

msgid "of type"
msgstr "do tipo"

msgid "field"
msgstr "campo"

#, python-format
msgid "a <strong>%(scheme)s</strong> URN"
msgstr "uma URM <strong>%(scheme)s</strong>"

msgid "Add contacts to"
msgstr "Adicionar contatos a"

msgid "called"
msgstr "chamado"

#, python-format
msgid "Created %(count)s new contact"
msgid_plural "Created %(count)s new contacts"
msgstr[0] "Criado %(count)s novo contato"
msgstr[1] "Criados %(count)s novos contatos"
msgstr[2] "Criados %(count)s novos contatos"

#, python-format
msgid "Updated %(count)s existing contact"
msgid_plural "Updated %(count)s existing contacts"
msgstr[0] "Atualizado %(count)s contato existente"
msgstr[1] "Atualizado %(count)s contatos existentes"
msgstr[2] "Atualizado %(count)s contatos existentes"

#, python-format
msgid "Added %(count)s contact to the <span class=\"linked\" onclick=\"goto(event)\" href=\"%(group_url)s\">%(group_name)s</span> group"
msgid_plural "Added %(count)s contacts to the <span class=\"linked\" onclick=\"goto(event)\" href=\"%(group_url)s\">%(group_name)s</span> group"
msgstr[0] "Adicionado %(count)s contato ao grupo <span class=\"linked\" onclick=\"goto(event)\" href=\"%(group_url)s\">%(group_name)s</span>"
msgstr[1] "Adicionados %(count)s contatos ao grupo <span class=\"linked\" onclick=\"goto(event)\" href=\"%(group_url)s\">%(group_name)s</span>"
msgstr[2] "Adicionados %(count)s contatos ao grupo <span class=\"linked\" onclick=\"goto(event)\" href=\"%(group_url)s\">%(group_name)s</span>"

#, python-format
msgid "Ignored %(count)s record because of errors"
msgid_plural "Ignored %(count)s records because of errors"
msgstr[0] "Ignorado %(count)s registro por causa de erros"
msgstr[1] "Ignorado %(count)s registros por causa de erros"
msgstr[2] "Ignorado %(count)s registros por causa de erros"

#, python-format
msgid "Row %(row)s: %(message)s"
msgstr "Linha %(row)s:%(message)s"

msgid "Message History"
msgstr "Histórico de mensagens"

msgid "Workspace Statistics"
msgstr "Estatísticas da área de trabalho"

msgid "This email was generated at"
msgstr "Este e-mail foi gerado em"

