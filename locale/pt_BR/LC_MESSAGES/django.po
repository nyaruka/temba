msgstr "Não foi possível registrar as chamadas de retorno: %(resp)s"

msgid "Please enter a valid phone number"
msgstr "Por favor insira um número de telefone válido"

msgid "This API key isn't working. Check it's the latest one for your number."
msgstr "Esta chave de API não está funcionando. Verifique se é a mais recente para o seu número."

msgid "Generated after registering your 360dialog account."
